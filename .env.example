POSTGRES_DB=btcusd
POSTGRES_USER=btcusd
POSTGRES_PASSWORD=replace-with-random-password
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
WEB_CPUS=0.50
MARKET_DATA_CPUS=0.75
BACKTEST_CPUS=1.00
POSTGRES_CPUS=0.50
MARKET_DATA_PARQUET=/data/btcusd_1m.parquet
MARKET_DATA_TIMEOUT_SECONDS=30
RUST_LOG=info
TLS_CERT_DIR=./deployment/certs

# Clerk authentication (frontend publishable key + backend JWT verification).
# Publishable keys and the issuer are public; never put the secret key here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Comma-separated origins allowed in the token's azp claim.
CLERK_AUTHORIZED_PARTIES=https://your-domain.example
