POSTGRES_DB=btcusd
POSTGRES_USER=btcusd
POSTGRES_PASSWORD=replace-with-random-password
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
WEB_CPUS=0.50
MARKET_DATA_CPUS=0.75
BACKTEST_CPUS=1.00
